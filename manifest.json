{
  "manifest_version": 3,
  "name": "uBlockTube",
  "version": "0.1.4",
  "description": "Remove os anúncios do player do YouTube (regras baseadas nas listas do uBlock Origin)",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "uBlockTube: bloqueio de anúncios do YouTube",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["js/page/youtube-hooks.js", "js/content/main.js"],
      "run_at": "document_start"
    }
  ]
}
